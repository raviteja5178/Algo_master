# Enhanced VWAP Mean-Reversion filters — uncomment what you want
VWAP_MR_ADX_MAX=25.0          # block entry when ADX >= 25 (trending day)
VWAP_MR_ZSCORE_ENTRY=2.0      # require >= 2 std dev extension
VWAP_MR_VOLUME_SPIKE=1.5      # require 1.5x average volume
VWAP_MR_MIN_RR=1.5            # require 1.5R reward to VWAP
VWAP_MR_VWAP_CROSS_MIN=1      # require >= 1 VWAP crossing today
