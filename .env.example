# Zerodha Kite Connect credentials
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Optional: Automated Daily Login Credentials
# Provide these to bypass manual login URL generation and fully automate startup!
# To get your KITE_TOTP_SECRET, enable 2FA TOTP on your Zerodha account settings.
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# Trading mode: PAPER | SHADOW | LIVE
TRADING_MODE=PAPER

# Safety switch — must be explicitly true to allow LIVE orders
ENABLE_LIVE_TRADING=false

# Instrument
UNDERLYING=SENSEX
QUANTITY=20
# Minimum option premium (LTP) to allow entry. 0 = disabled.
# Prevents buying near-expiry / deep-OTM options with no recovery room.
# Recommended: 300 for SENSEX weekly options.
MIN_OPTION_ENTRY_PRICE=270

# Risk parameters (in option premium points)
INITIAL_SL_POINTS=30
BREAK_EVEN_TRIGGER_POINTS=30
TRAIL_STEP_POINTS=10

# Target reference
INITIAL_TARGET_OFFSET_POINTS=50
TARGET_TRAIL_STEP_POINTS=10
USE_LIVE_TARGET_ORDER=false

# ── ATR-adaptive risk ─────────────────────────────────────────────────────────
# Two active modes, evaluated in priority order:
#
# Mode D — swing high/low as SL (USE_SWING_SL=true)  [highest priority]
#   SL placed at nearest structural pivot (mirrors TradingView AI Copilot).
#   Falls back to Mode C automatically when no swing level is found.
#
# Mode C — SENSEX spot ATR × multiplier (USE_SPOT_ATR_RISK=true)  [default]
#   SL     = ATR(SPOT_ATR_PERIOD, SENSEX 5m) × SPOT_ATR_SL_MULT × ATM_delta(0.4)
#   Target = SL × SPOT_ATR_TARGET_RR   (R:R ratio — 1.2 = minimum recommended)
#   Trail  = SL × SPOT_ATR_TRAIL_RR    (0.5 = half the SL distance)
#   Adapts to market momentum: wider SL on volatile days, tighter on calm days.
#   Mirrors the TradingView "ATR 5 Min Index Study".
#
# Fixed fallback — used only when ATR is unavailable (cold start / <5 candles).
#   Uses INITIAL_SL_POINTS / INITIAL_TARGET_OFFSET_POINTS / TRAIL_STEP_POINTS.

# Mode C — SENSEX spot ATR risk
USE_SPOT_ATR_RISK=true
SPOT_ATR_PERIOD=5
SPOT_ATR_SL_MULT=2.5
SPOT_ATR_TARGET_RR=1.2
SPOT_ATR_TRAIL_RR=0.5
# ATR-dynamic TSL — stop floats at highest_ltp - ATR(TSL_ATR_PERIOD) × TSL_ATR_TRAIL_MULT × 0.4
# 0.0 = disabled (fixed step trail).  Recommended: 0.5
# When enabled, the stop adapts each tick: tighter in calm markets, wider in trending moves.
TSL_ATR_TRAIL_MULT=0.0
TSL_ATR_PERIOD=5
# Mode D — swing SL (structure-based, like TradingView Copilot SL placement)
# Falls back to Mode C automatically when no swing level is found.
USE_SWING_SL=false
SWING_SL_LENGTH=10
MIN_RR=1.2

# Session times (IST, HH:MM)
FORCE_EXIT_TIME=15:15
NO_NEW_ENTRY_AFTER=15:00

# Timezone
TIMEZONE=Asia/Kolkata

# Expiry: CONFIGURED | AUTO
EXPIRY_MODE=CONFIGURED
CONFIGURED_EXPIRY=2026-01-30

# Persistence
DB_PATH=trades.db

# Strategy Toggles
ENABLE_EMA_STRATEGY=true
ENABLE_ORB_STRATEGY=true

# Momentum phase (afternoon breakout window, opt-in)
# Fires CE_MOM/PE_MOM on large-body candles in the afternoon window.
ENABLE_MOMENTUM_PHASE=true
MOMENTUM_MIN_BODY_PTS=40.0
MOMENTUM_WINDOW_START=13:30
MOMENTUM_WINDOW_END=14:30
# Momentum guards (0 = off):
MOMENTUM_MAX_TRADES_PER_DAY=1          # max filled MOM trades per day
MOMENTUM_REENTRY_COOLDOWN_CANDLES=6    # no same-direction MOM for 6 candles (30 min) after a MOM exit
MOMENTUM_MAX_SL_ATR=2.0                # skip if swing SL > 2 × ATR(SPOT_ATR_PERIOD) away
MOMENTUM_MIN_ROOM_ATR=0.5              # skip if < 0.5 × ATR below prior day high (CE) / above low (PE)

# Smart Entry Filter — quality gate applied AFTER a raw signal fires (all default OFF)
#
# SMART_ENTRY_MIN_BODY_ATR_RATIO : signal candle body must be >= this fraction of ATR(14).
#                                  0.0 = disabled.  Recommended: 0.3
#                                  Rejects doji / wick-spike entries with no momentum.
# SMART_ENTRY_REQUIRE_EMA_SLOPE  : true = EMA9 must be rising (CE) or falling (PE).
#                                  Prevents entering a stalling or decelerating move.
# SMART_ENTRY_COOLDOWN_CANDLES   : block new entries for N candles after an SL loss.
#                                  0 = disabled.  Recommended: 2 (= 10 minutes)
#                                  Prevents re-entering a choppy / reversing market.
SMART_ENTRY_MIN_BODY_ATR_RATIO=0.0
SMART_ENTRY_REQUIRE_EMA_SLOPE=false
SMART_ENTRY_COOLDOWN_CANDLES=0
# SMART_ENTRY_MIN_EMA_GAP_PTS      : |EMA9 - EMA21| must be >= this many index points.
#                                    0.0 = disabled.  Recommended: 10
#                                    Rejects entries in compressed/flat EMA zones (noise).
#                                    Today's 14:25 CE fired with gap = +0.57 pts — clearly noise.
# SMART_ENTRY_REQUIRE_EMA_GAP_WIDENING : true = EMA gap must be expanding on the signal candle.
#                                    Prevents entering a decelerating trend where gap is shrinking.
#                                    Today's 13:00 CE: gap shrank 4 candles before entry fired.
SMART_ENTRY_MIN_EMA_GAP_PTS=0.0
SMART_ENTRY_REQUIRE_EMA_GAP_WIDENING=false
# SMART_ENTRY_REQUIRE_15M_TREND : true = latest completed 15m candle must close
#                                    above 15m EMA21 for CE entries, below for PE.
#                                    Higher-timeframe structure filter — prevents
#                                    buying in a 15m downtrend / selling in a 15m uptrend.
#                                    Skipped (fail-open) when < 21 completed 15m candles.
#                                    Recommended: true
SMART_ENTRY_REQUIRE_15M_TREND=false
#
# SMART_ENTRY_15M_MAX_GAP_PTS  : Softens the 15m trend filter.
#                                    0 = binary block (original: any gap in wrong direction blocks)
#                                    >0 = only block CE when 15m close is MORE than this pts
#                                    below EMA21.  Allows entries during early recoveries where
#                                    the 15m EMA21 is lagging behind the rally.
#                                    Example: 150 → allows CE when gap is -50 but blocks at -200.
#                                    Only active when SMART_ENTRY_REQUIRE_15M_TREND=true.
#                                    Recommended: 150 for SENSEX.
SMART_ENTRY_15M_MAX_GAP_PTS=150.0
#
# SMART_ENTRY_SQUEEZE_BYPASS   : Bypass 15m trend and EMA slope filters when
#                                    the last N 5m candles are ALL same-direction.
#                                    Captures momentum squeeze moves (e.g. 300-pt rally
#                                    in 45 mins) where the 15m EMA21 hasn't caught up.
#                                    true = enable bypass.  Recommended: true.
# SMART_ENTRY_SQUEEZE_CANDLES  : Number of consecutive same-direction 5m candles
#                                    required to activate the bypass.  Recommended: 3.
SMART_ENTRY_SQUEEZE_BYPASS=false
SMART_ENTRY_SQUEEZE_CANDLES=3
#
# SMART_ENTRY_MAX_PREMIUM_EXTENSION_PCT : block entry when the option LTP has
#                                          already risen more than this fraction
#                                          above its first-seen price today.
#
#  Problem:  EMA fires a CE signal at ₹331 on SENSEX26O0173000CE which opened
#            the day at ₹140 — the entire move is done; the bot buys at the peak.
#            Extension = (331-140)/140 = 136% → if limit is 100% → BLOCKED.
#
#  How it works: the first LTP seen for each option is recorded automatically.
#  If at signal time:
#    current_ltp  >  first_seen_ltp × (1 + MAX_PREMIUM_EXTENSION_PCT)
#  the entry is blocked regardless of EMA alignment.
#
#  Examples (default value = 1.0, i.e. block after a >100% move):
#    first=140, current=331 → +136% →  136 > 100 → BLOCKED   ← Sep 30 T8 blocked
#    first=140, current=265 → +89%  →   89 < 100 → ALLOWED
#    first=200, current=350 → +75%  →   75 < 100 → ALLOWED
#    first=200, current=410 → +105% →  105 > 100 → BLOCKED
#
#  0 = disabled (no premium extension check).
#  1.0 = block entry after a 100% premium move (recommended — catches peak entries).
#  1.5 = block only after a 150% move (more permissive).
SMART_ENTRY_MAX_PREMIUM_EXTENSION_PCT=1.0
# SMART_ENTRY_BOUNCE_EXEMPT_STRATEGIES : comma-separated strategy suffixes that
#   bypass body/ATR (Filter 1) and EMA gap magnitude/widening (Filters 4 & 5).
#   VWAP, NATR, and ORB are exempt by default — their own structural levels/range
#   already confirm the entry direction; EMA gap is expected to be flat at a retest/open.
#   IMPORTANT: always keep NATR and ORB here.
SMART_ENTRY_BOUNCE_EXEMPT_STRATEGIES=VWAP,NATR,ORB
# SMART_ENTRY_SLOPE_EXEMPT_STRATEGIES : comma-separated strategy suffixes that
#   bypass the EMA9 slope filter (Filter 2).
#   NATR is exempt by default: its trailing-stop crossover IS the trend-flip
#   signal — EMA9 lags and will be pointing the wrong way at the inflection.
#   IMPORTANT: always keep NATR here — removing it causes slope filter to block
#   valid NATR entries (Oct 01: PE_NATR blocked on 3-pt EMA9 noise rise).
SMART_ENTRY_SLOPE_EXEMPT_STRATEGIES=NATR


# ORB false-breakout filters
#
# ORB_MIN_BODY_RATIO   : breakout candle body/range >= this fraction.
#                        0.0 = disabled.  Recommended: 0.0 (ORB candle range provides structure).
#                        Rejects doji / wick-only pokes through the ORB level.
# ORB_BUFFER_ATR_MULT  : close must exceed ORB level by ATR(14)*mult.
#                        0.1 = recommended. Rejects 1-tick / noise breakouts.
# ORB_REQUIRE_15M_TREND: true = CE_ORB only when 15m close > 15m EMA21,
#                               PE_ORB only when 15m close < 15m EMA21.
#                        Prevents counter-trend ORB entries on choppy days.
ORB_MIN_BODY_RATIO=0.0
ORB_BUFFER_ATR_MULT=0.1
ORB_REQUIRE_15M_TREND=true
# ORB_ACTIVE_UNTIL: hard cutoff — ORB is disabled after this time; EMA takes over.
# Entry window is internally locked to 09:25–09:40 regardless of this setting.
# Default: 09:40
ORB_ACTIVE_UNTIL=09:40
# ORB_NO_THURSDAY: block ORB entries on Thursdays (expiry day).
# Backtest shows expiry-day ORB breaks are often reversal traps (0% WR).
ORB_NO_THURSDAY=false

# ORB Session Qualifier — sideways-day filter (data-driven, opt-in)
# When true, the bot checks at 10:00 whether the ORB breakout is still holding.
# If price has closed back INSIDE the ORB range, all non-momentum strategies
# (EMA, VWAP, TRB, PDHL, OB) are silenced from 10:00 until MOMENTUM_WINDOW_START.
# Based on 6-month SENSEX data: 57% of days are sideways — this kills the
# grinding-loss pattern caused by EMA/VWAP repeatedly firing on those days.
# The Momentum Phase 2 window (13:30–14:30) is always exempt from this block.
# false = legacy behaviour (no filtering).  true = recommended.
ORB_SESSION_QUALIFIER=false
# ORB_QUALIFIER_UNBLOCK_TIME: time at which the session block is lifted.
# Strategies blocked by the session qualifier are re-enabled from this time.
# "13:30" = block until afternoon MOM window (default, more aggressive filter)
# "11:30" = shorter block — re-enables EMA/VWAP earlier on slow-start days
ORB_QUALIFIER_UNBLOCK_TIME=13:30

# Order Block (OB) strategy — fires CE_OB/PE_OB when close enters a valid OB zone
# Logic mirrors the Flux Charts "Volumized Order Blocks" Pine Script indicator.
# OB_INVALIDATION: "Wick" (wick pierces zone) or "Close" (close pierces zone)
ENABLE_OB_STRATEGY=true
OB_SWING_LENGTH=10
OB_MAX_ATR_MULT=3.5
OB_ATR_PERIOD=10
OB_MAX_BLOCKS=3
OB_INVALIDATION=Wick
# OB_APPROACH_BUFFER_ATR_MULT: extend the signal to fire when price *approaches*
# the OB from outside, not only when already inside the zone.
#   PE_OB: fires when close >= ob.bottom - buffer_pts  (sell-the-retest)
#   CE_OB: fires when close <= ob.top   + buffer_pts  (pullback-to-OB)
#   buffer_pts = OB_APPROACH_BUFFER_ATR_MULT × ATR(OB_ATR_PERIOD)
#   0.0 = disabled (inside zone only — original behaviour).
#   0.2 = recommended — catches the approach 1-2 candles before entry into zone.
#         At ATR5=111 on SENSEX this equals ~22 pts of buffer below the OB bottom.
#   Mirrors TradingView AI Copilot "sell the retest" entries which fire on the
#   approach rather than requiring price to enter the OB.
OB_APPROACH_BUFFER_ATR_MULT=0.2

# Time Range Breakout (TRB) strategy — fires CE_TRB/PE_TRB based on 9:45-10:00 15m breakout
ENABLE_TRB_STRATEGY=true
TRB_CANDLE_START_TIME=09:45
TRB_CANDLE_DURATION_MINS=15
TRB_MIN_BODY_RATIO=0.0
TRB_BUFFER_ATR_MULT=0.0

# VWAP Retest strategy — fires CE_VWAP/PE_VWAP on VWAP retest + bounce
# VWAP resets at 09:15 each day and is built from completed 5m candles.
ENABLE_VWAP_STRATEGY=true
# Enable / disable CE (Call) and PE (Put) VWAP entries independently (default true)
# Set ENABLE_CE_VWAP=false to disable CE_VWAP trades while keeping PE_VWAP active.
ENABLE_CE_VWAP=true
ENABLE_PE_VWAP=true
# Candles to look back for the retest dip/pop (default 3 = last 15 minutes)
VWAP_RETEST_LOOKBACK=3
# Minimum pts the close must clear VWAP to confirm a real bounce.
# 0 = disabled (any close past VWAP fires).
# 30 = close must be >= 30 pts beyond VWAP — filters weak/noise bounces.
#
# Why 30: Oct-05 analysis showed two losing VWAP signals had clearance of only
# 6 pts (10:35 CE) and 24 pts (11:15 PE) — the bounce had no conviction.
# The winning signal at 13:20 had 61 pts clearance. 30 pts is the midpoint.
# This replaces the need for body-filter and EMA-gap-filter on VWAP signals:
# if the bounce is strong enough to clear 30 pts, the body will follow.
VWAP_MIN_BOUNCE_PTS=30.0
# Maximum consecutive candles price can stay on the opposite side of VWAP before bouncing.
# Prevents false breakouts where price has been in a prolonged downtrend below VWAP
# and makes a counter-trend spike into overhead VWAP resistance. (0 = disabled, default 3)
VWAP_MAX_SUBMERGED_CANDLES=3

# Previous Day High/Low (PDHL) Breakout strategy — fires CE_PDHL/PE_PDHL
# PDH/PDL fetched from Zerodha daily candles at bot startup.
ENABLE_PDHL_STRATEGY=true
# Extra buffer beyond PDH/PDL the close must clear to filter noise. 0 = disabled.
PDHL_BUFFER_PTS=0.0

# NATR Trailing Stop strategy -- fires CE_NATR/PE_NATR on ATR trailing stop crossover
# Best-match for TradingView AI Chart Copilot (derived from Oct 2026 screenshot):
#   NATR_PERIOD=5, NATR_MULT=2.5  → fast ratcheting stop, matches Copilot's PE entries at 12:50
#   NATR_PERIOD=21, NATR_MULT=3.0 → original slower version (fires later)
ENABLE_NATR_STRATEGY=true
NATR_PERIOD=5
NATR_MULT=2.5
# NATR_MIN_OPTION_ENTRY_PRICE: per-strategy premium floor override for NATR signals.
# NATR fires early in a trend flip — before the ATM option premium has inflated.
# The global MIN_OPTION_ENTRY_PRICE (e.g. 300) is designed for deep-OTM protection,
# not early-move ATM entries at ₹250-280 which are legitimate NATR setups.
# 0.0 = use MIN_OPTION_ENTRY_PRICE (no override — default, safe).
# Recommended: 150 — protects against truly worthless options while allowing
#   fair-valued early-trend entries that the global floor would reject.
NATR_MIN_OPTION_ENTRY_PRICE=0.0

# ── Smart Exit sub-features ───────────────────────────────────────────────────
# All default OFF. Baseline lifecycle: ENTRY → SL → BREAK-EVEN → TSL → EOD.
#
# Enable one at a time after verifying the core lifecycle is fully reliable
# in paper/shadow mode — otherwise it becomes impossible to attribute why a
# position closed.
#
# IMPORTANT: the bot will REFUSE TO START if a sub-feature is enabled but its
# required parameter is blank or zero.  Never leave a parameter value empty
# when the corresponding feature flag is true.
#
# FILL_PRICE_UNCONFIRMED: if the exchange returns COMPLETE but no fill price
# after 5 retries, the bot will NOT use the current LTP as a fallback.
# It returns status=PRICE_UNCONFIRMED so the caller can protect the position
# conservatively and keep polling for the actual fill price.
#
ENABLE_SMART_EXIT=true
ENABLE_REVERSAL_EXIT=false
ENABLE_EMA_COLLAPSE_EXIT=false
# Profit-lock exit: close the position the moment the option LTP reaches
# entry + ATR(at entry) × PROFIT_LOCK_ATR_MULT.
#
# Why: the trailing-stop BE mechanism only moves the floor to entry price.
# After that it ratchets upward only by trail_step_points at a time (which
# equals 0.5 × SL — often 50-100 pts on SENSEX).  If the LTP peaks and
# reverses before the next ratchet fires, the entire unrealised gain is lost.
#
# Example (Oct-05 CE_VWAP): entry=577, trail_step=101, peak=678.
#   BE fires at peak 578 → floor = 577 (entry).
#   No second ratchet (peak − entry = 101 = exactly one step, no step above it).
#   Price retraced to 571 → exited at entry (−Rs.126) despite being up +101 pts.
#   With PROFIT_LOCK_ATR_MULT=0.5, ATR=147 → threshold = 577 + 73 = 650.
#   LTP 678 > 650 → PROFIT_LOCK fires → exit ≈ +101 pts → +Rs.808.
#
# PROFIT_LOCK_ATR_MULT=0.5 = lock when LTP passes entry + 0.5 × ATR(at entry)
#   This is typically ~0.5 × the initial SL distance — a 0.5:1 R:R minimum lock.
#   Lower values lock sooner (safer, smaller wins). 0.0 = disabled.
ENABLE_PROFIT_LOCK_EXIT=true
ENABLE_TIME_DECAY_EXIT=false
ENABLE_DAILY_LOSS_LIMIT=false
# Required when ENABLE_PROFIT_LOCK_EXIT=true  — must be > 0
PROFIT_LOCK_MULTIPLIER=2.0
#
# Dynamic profit lock — threshold = max(ATR-based, %-based).
# ATR-based is active below. %-based is OFF (PROFIT_LOCK_MIN_PCT=0.0).
#
# PROFIT_LOCK_ATR_MULT  : threshold = entry + ATR(at entry) × this value.
#   Scales with index volatility — tight on calm days, wider on volatile days.
#   0.5 = lock when LTP exceeds entry by 50% of the initial ATR SL distance.
#   Example: entry=577, ATR=147 → threshold=651; entry=225, ATR=55 → threshold=253.
PROFIT_LOCK_ATR_MULT=0.5
#
# PROFIT_LOCK_MIN_PCT   : threshold = entry × (1 + this value).
#   Scales with option premium — ensures lock is proportional on high entries.
#   Recommended: 0.5  →  entry=520 → lock at 780 pts (50% gain)
#   Best for: high-premium entries (entry > ~400), used alongside ATR mult
#   Final threshold = max(ATR-based, %-based) — whichever is further in profit
# PROFIT_LOCK_MIN_PCT=0.0 — keep off; ATR-based lock already handles it.
PROFIT_LOCK_MIN_PCT=0.0
# Required when ENABLE_PROFIT_LOCK_EXIT=true — ATR mult per-regime override
# (used by Regime Classifier; otherwise PROFIT_LOCK_ATR_MULT applies)
# Required when ENABLE_TIME_DECAY_EXIT=true   — must not be blank
TIME_DECAY_EXIT_AFTER=14:45
# Required when ENABLE_TIME_DECAY_EXIT=true   — must be > 0
TIME_DECAY_MIN_PNL_PTS=20.0
# Required when ENABLE_DAILY_LOSS_LIMIT=true  — must be > 0
# UNITS: RUPEES. 3000 = stop new entries after Rs 3000 of
# realised loss today. Pivot trades: blocks new entries only; EMA trades: also closes the open position.
DAILY_LOSS_LIMIT_RUPEES=3000

# ── AI Regime Classifier ──────────────────────────────────────────────────────
# Classifies each trading day as TRENDING / CHOPPY / VOLATILE at bot startup.
# Adjusts profit lock thresholds accordingly — wider on trending days, tighter on choppy.
# REGIME_USE_AI=false uses pure heuristics (VIX + gap%). No API key needed.
ENABLE_REGIME_CLASSIFIER=false
REGIME_USE_AI=false
REGIME_AI_PROVIDER=openai          # openai | watsonx | ollama
REGIME_AI_MODEL=gpt-4o-mini
# not needed when REGIME_AI_PROVIDER=ollama
REGIME_AI_API_KEY=
REGIME_AI_OLLAMA_HOST=http://localhost:11434
# Manual VIX override — set to today's INDIA VIX value (e.g. 14.5). 0 = auto-heuristic.
REGIME_VIX_OVERRIDE=0.0
# Profit lock ATR mult per regime (replaces PROFIT_LOCK_ATR_MULT when classifier active)
REGIME_ATR_MULT_TRENDING=1.5
REGIME_ATR_MULT_CHOPPY=0.8
REGIME_ATR_MULT_VOLATILE=1.2
# Profit lock min pct per regime (replaces PROFIT_LOCK_MIN_PCT when classifier active)
REGIME_MIN_PCT_TRENDING=0.6
REGIME_MIN_PCT_CHOPPY=0.3
REGIME_MIN_PCT_VOLATILE=0.5

# ── Intraday market regime (rule-based, no AI, observational only) ────────────
# TRENDING / CHOPPY / MIXED + VOLATILE overlay, recomputed on every closed 5m
# candle from Efficiency Ratio, ADX and ATR-vs-baseline.  Shown on the dashboard
# and stored in trades.smart_entry_flags.  Never blocks or changes a trade.
ENABLE_INTRADAY_REGIME=true
INTRADAY_REGIME_ER_PERIOD=12
INTRADAY_REGIME_ADX_PERIOD=14
INTRADAY_REGIME_ER_TRENDING=0.5
INTRADAY_REGIME_ER_CHOPPY=0.3
INTRADAY_REGIME_ADX_TRENDING=25
INTRADAY_REGIME_VOL_RATIO=1.5

# ── Order-flow tick recorder (research data collection, default OFF) ──────────
# Records the near-month SENSEX future's ticks + 5-level depth to daily CSVs
# (research/data/orderflow/ticks_YYYY-MM-DD.csv) so order-flow ideas (delta, absorption,
# imbalance) can be back-tested later.  Kite's historical API has no bid/ask or depth.
# Never affects trading.  LIVE/SHADOW only.  Expect a few MB per session (not yet
# measured -- check research/data/orderflow after the first day).
ENABLE_ORDERFLOW_RECORDER=false
ORDERFLOW_RECORD_DIR=
ORDERFLOW_DEPTH_SAMPLE_SECONDS=1.0
ORDERFLOW_FUT_MIN_DAYS_TO_EXPIRY=3

# ── AI Entry / Exit Confirmation ──────────────────────────────────────────────
# Optional LLM quality gate: every rule-based signal is scored by an LLM before
# the bot places an order. Any LLM error falls back to normal rule-based execution.
ENABLE_AI_CONFIRMATION=false

# Provider — choose ONE:
#   openai   : OpenAI API (paid). Needs AI_CONFIRMATION_API_KEY.
#   watsonx  : IBM watsonx.ai (paid/trial). Needs AI_CONFIRMATION_API_KEY.
#   ollama   : FREE, runs on your own machine — no API key needed.
#              Setup (one time):
#                1. Install Ollama: https://ollama.com/download
#                2. Pull a model:   ollama pull llama3.2
#                3. Set below:      AI_CONFIRMATION_PROVIDER=ollama
#                                   AI_CONFIRMATION_MODEL=llama3.2
#              Ollama must be running when the bot starts (it runs as a background service).
#              Recommended models (speed → quality trade-off):
#                phi3:mini   — fastest, least RAM (~2 GB)
#                llama3.2    — fast, good JSON  (recommended default)
#                mistral     — slower, better reasoning
AI_CONFIRMATION_PROVIDER=openai
AI_CONFIRMATION_MODEL=gpt-4o-mini
# not needed when PROVIDER=ollama
AI_CONFIRMATION_API_KEY=
# Ollama server URL — only used when AI_CONFIRMATION_PROVIDER=ollama
# Default http://localhost:11434 works for standard Ollama install on same machine.
AI_CONFIRMATION_OLLAMA_HOST=http://localhost:11434
# Entry score threshold (1-10). Signal blocked if LLM scores below this.
AI_ENTRY_SCORE_THRESHOLD=6
# Also ask the LLM on each candle close whether to exit the open position.
ENABLE_AI_EXIT=false
# Exit score threshold (1-10). Position closed if LLM urgency >= this.
AI_EXIT_SCORE_THRESHOLD=7

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Pivot formula: FIBONACCI (default) or TRADITIONAL
PIVOT_FORMULA=FIBONACCI

# Pivot Sustain strategy
ENABLE_PIVOT_STRATEGY=true
PIVOT_SUSTAIN_CANDLES=2
PIVOT_ATR_PERIOD=14
PIVOT_SL_MODE=SIGNAL_LOW
PIVOT_SL_ATR_MULT=1.0
PIVOT_SL_BUFFER_ATR=0.3
PIVOT_MIN_ROOM_R=1.0
PIVOT_BE_TRIGGER_R=1.5
PIVOT_BE_BUFFER_PTS=5.0
PIVOT_T1_LOCK_PCT=0.5
PIVOT_TRAIL_ATR_MULT=1.0
PIVOT_HARD_SL_CUSHION=1.75
PIVOT_MAX_TRADES_PER_DAY=3
PIVOT_COUNTER_TREND_BLOCK=true
# PIVOT_MIN_TODAY_CANDLES: require at least N completed 5m candles today before any pivot signal.
# Current 3 = allows entries from 09:30 (candle 3). Backtest (1 year) by candle:
#   candle 3 (09:30): 10 trades, WR 40%, Net +Rs1,237, PF 1.41  -- marginal
#   candle 4 (09:35):  5 trades, WR 20%, Net +Rs2,437, PF 2.92  -- kept: big T2 trades here
#   candle 5+ (09:40):  5 trades, WR  0%, Net -Rs5,362, PF 0.00 -- pure losses
# Setting to 4 removes the low-quality 09:30 entries (+Rs916 net improvement, PF 2.17->2.31)
# without cutting the strong 09:35 T1/T2 setups (Mar-11 PE +Rs3,815, Jul-14 PE +Rs3,061).
PIVOT_MIN_TODAY_CANDLES=4
# Open-Direction quality filters (fix for Oct 9 PE_PIVOT false signal)
# PIVOT_OD_MIN_GAP_ATR     : open must be >= this × ATR away from Pivot.
#   0.4 = require the open to be at least ~46 pts (0.4 × ATR 114) from Pivot.
#   Blocks signals when the open is hovering inside the Pivot noise band.
PIVOT_OD_MIN_GAP_ATR=0.4
# PIVOT_OD_FIRST_CANDLE_CONFIRM : first 5m candle's body must confirm direction.
#   true = CE requires bullish first candle; PE requires bearish first candle.
#   Blocks PE entries when the first candle is a doji or closes flat/higher.
PIVOT_OD_FIRST_CANDLE_CONFIRM=true
# PIVOT_OD_MAX_FIRST_WICK_ATR  : first candle counter-direction wick cap.
#   0.25 = block if PE first candle's upper wick >= 0.25 × ATR (bullish probe toward Pivot).
#   0.0  = disabled (legacy behaviour).
PIVOT_OD_MAX_FIRST_WICK_ATR=0.25
# PIVOT_ACCEPTANCE : Mode C cross-and-acceptance entry.
#   Fires once per Pivot cross: price closed/opened on the wrong side, crossed,
#   and the first 2 clean candles (close + wick on the new side) confirm it.
#   Catches Oct-9-style trend days the cross-candle wick hides from Mode B.
#   Backtest 13-Aug→09-Oct-2026 (40 days): baseline 1 trade -5 pts →
#   24 trades, 29% win, +730 pts net of 10 pts/trade cost, PF 2.35.
PIVOT_ACCEPTANCE=true
# Acceptance guards (Oct 19 2026: two PE_PIVOT acceptance entries hugging the Pivot
# were both stopped out).  A 400-day index backtest supports MIN_DIST_ATR + MIN_ROOM_R
# (0.51R/trade vs 0.39R unguarded) but NOT the regime / per-side gates, which cut total R.
#   MIN_DIST_ATR  : signal close must be >= N x ATR beyond the Pivot (0 = off)
#   MIN_ROOM_R    : T1 room >= N x risk for acceptance entries (max with PIVOT_MIN_ROOM_R)
#   BLOCK_REGIMES : intraday regimes (CHOPPY,MIXED,WARMUP,TRENDING) where acceptance is skipped (empty = off)
#   MAX_PER_SIDE  : acceptance signals per side per day (0 = unlimited)
PIVOT_ACCEPT_MIN_DIST_ATR=0.5
PIVOT_ACCEPT_MIN_ROOM_R=1.5
PIVOT_ACCEPT_BLOCK_REGIMES=
PIVOT_ACCEPT_MAX_PER_SIDE=0

# PIVOT_BOUNCE_ZONE_ATR : support-bounce (CE) / resistance-rejection (PE) at
#   every pivot level S3..R3, evaluated inside the same pivot strategy.
#   Signal candle wicks into level ± this × ATR and closes back on its
#   approach side with a confirming body.  Targets = next levels.
#   0.0 = disabled.  0.15 recommended: in the 1-year replay, Bounce contributed
#   about half of the strategy's points; disabling it cut total points by 47%.
PIVOT_BOUNCE_ZONE_ATR=0.15
# Bounce quality filters (only used when PIVOT_BOUNCE_ZONE_ATR > 0):
# IMPORTANT: always keep PIVOT_BOUNCE_CONFIRM_NEXT=true in production.
#   Without it the bounce candle itself triggers entry — the S/R level
#   hasn't been re-tested and confirmed yet, so the trade enters purely on
#   a wick touch with no follow-through evidence.  The confirmation candle
#   (must close above signal-candle high for CE / below low for PE) provides
#   the minimum evidence that buyers/sellers are committed at the level.
PIVOT_BOUNCE_MIN_RANGE_ATR=0.6     # signal candle range >= 0.6 × ATR (rejects doji wicks)
PIVOT_BOUNCE_MIN_WICK_PCT=0.5      # rejection wick >= 50% of candle range
PIVOT_BOUNCE_TREND_EMA=21          # CE only above EMA21, PE only below (0 = off)
PIVOT_BOUNCE_CONFIRM_NEXT=true     # next candle must break signal high (CE) / low (PE)

