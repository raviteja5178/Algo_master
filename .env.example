# ── Pivot — additional settings ───────────────────────────────────────────
# PIVOT_NO_NEW_ENTRY_AFTER: block new pivot entries at or after this time (HH:MM).
# Backtest (1 year): 14:00+ entries = 17 trades, 0 wins, -Rs 11,841 (PF 0.00).
# Empty = disabled (falls through to global NO_NEW_ENTRY_AFTER).
# Recommended: 14:00
PIVOT_NO_NEW_ENTRY_AFTER=14:00
# PIVOT_NO_FRIDAY: disable all new pivot entries on Fridays.
# Backtest (1 year): Fridays = 20 trades, 15% WR, -Rs 9,096 (PF 0.37).
# Recommended: true
PIVOT_NO_FRIDAY=true
PIVOT_ZONE_BUFFER=25
PIVOT_BREAKOUT_CONFIRM=false
PIVOT_OPTION_DELTA=0.4
PIVOT_T2_LOCK_PCT=0.50
PIVOT_T2_TRAIL_ATR_MULT=0.75

# ── General / risk / misc ────────────────────────────────────────────────
KITE_TOKEN_DATE=
USE_ATR_RISK='true'
ORB_MOMENTUM_SKIP_MONDAY=true
EXPIRY_DAY_ROLLOVER_TIME=12:30
ENABLE_PIVOT_LEVELS=true
